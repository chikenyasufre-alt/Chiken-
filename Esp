-- ===== ESP PARA JUGADORES (adaptado) =====
local espObjects = {}

local function newDrawing(type)
    if not Drawing then return nil end
    return Drawing.new(type)
end

-- Función para encontrar la parte principal del personaje (genérico)
local function getCharacterParts(character)
    local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not rootPart or not humanoid then return nil, nil end
    return rootPart, humanoid
end

local function createPlayerESP(player)
    if player == LocalPlayer then return end
    if espObjects[player] then return end
    local character = player.Character
    if not character then return end
    
    local rootPart, humanoid = getCharacterParts(character)
    if not rootPart then return end
    
    local esp = {
        Box = newDrawing("Square"),
        Name = newDrawing("Text"),
        HealthBar = newDrawing("Line"),
        HealthBarBg = newDrawing("Line"),
    }
    
    if esp.Box then
        esp.Box.Thickness = 2
        esp.Box.Transparency = 0.3
        esp.Box.Filled = false
    end
    if esp.Name then
        esp.Name.Size = 16
        esp.Name.Center = true
        esp.Name.Outline = true
        esp.Name.OutlineColor = Color3.new(0, 0, 0)
    end
    espObjects[player] = esp
end

local function removePlayerESP(player)
    local esp = espObjects[player]
    if esp then
        for _, obj in pairs(esp) do
            if obj and obj.Remove then obj:Remove() end
        end
        espObjects[player] = nil
    end
end

local function updatePlayerESP(player)
    local esp = espObjects[player]
    if not esp then return end
    local character = player.Character
    if not character then removePlayerESP(player) return end
    
    local rootPart, humanoid = getCharacterParts(character)
    if not rootPart or not humanoid then return end
    
    local vector, onScreen = Camera:WorldToScreenPoint(rootPart.Position)
    local show = onScreen and boxToggle.State
    
    local espColor = colors[colorIndex].Color
    
    -- Tamaño de la caja según la distancia
    local distance = (Camera.CFrame.Position - rootPart.Position).Magnitude
    local sizeMultiplier = math.clamp(200 / distance, 0.5, 3)
    local boxSize = 3 * sizeMultiplier
    local boxHeight = 6 * sizeMultiplier
    
    if esp.Box then
        esp.Box.Visible = show
        if show then
            esp.Box.Position = Vector2.new(vector.X - boxSize, vector.Y - boxHeight)
            esp.Box.Size = Vector2.new(boxSize * 2, boxHeight * 2)
            esp.Box.Color = espColor
        end
    end
    
    if esp.Name then
        esp.Name.Visible = onScreen and nameToggle.State
        if esp.Name.Visible then
            esp.Name.Position = Vector2.new(vector.X, vector.Y - boxHeight - 25)
            esp.Name.Text = player.Name
            esp.Name.Color = espColor
        end
    end
    
    if esp.HealthBar and esp.HealthBarBg then
        local healthVis = onScreen and healthToggle.State
        local hp = humanoid.Health / humanoid.MaxHealth
        local barW = 35 * sizeMultiplier
        local barH = 3 * sizeMultiplier
        
        esp.HealthBarBg.Visible = healthVis
        esp.HealthBar.Visible = healthVis
        
        if healthVis then
            esp.HealthBarBg.From = Vector2.new(vector.X - barW/2, vector.Y + boxHeight + 5)
            esp.HealthBarBg.To = Vector2.new(vector.X + barW/2, vector.Y + boxHeight + 5)
            esp.HealthBarBg.Color = Color3.new(0.2, 0.2, 0.2)
            esp.HealthBarBg.Thickness = barH
            
            esp.HealthBar.From = Vector2.new(vector.X - barW/2, vector.Y + boxHeight + 5)
            esp.HealthBar.To = Vector2.new(vector.X - barW/2 + (barW * hp), vector.Y + boxHeight + 5)
            esp.HealthBar.Color = Color3.new(1 - hp, hp, 0)
            esp.HealthBar.Thickness = barH
        end
    end
end

-- ===== ITEMS DROPEADOS (adaptado) =====
local droppedItems = {}

local function updateDroppedItems()
    if not dropToggle.State then
        for _, esp in pairs(droppedItems) do
            if esp and esp.Remove then esp:Remove() end
        end
        droppedItems = {}
        return
    end
    
    -- Busca partes que NO sean de personajes y que tengan tamaño pequeño o nombres específicos
    for _, part in pairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and part.Parent and not part.Parent:IsA("Character") then
            -- Filtros para Block Spin: busca partes con nombres comunes de items
            local name = part.Name:lower()
            local isDrop = false
            
            -- Palabras clave para items en Block Spin
            local keywords = {"item", "drop", "pickup", "coin", "gem", "crystal", "box", "chest", "weapon", "gun", "sword", "tool"}
            for _, kw in pairs(keywords) do
                if name:find(kw) then
                    isDrop = true
                    break
                end
            end
            
            -- También detecta por tamaño (partes pequeñas suelen ser items)
            if not isDrop and part.Size.Magnitude < 5 then
                isDrop = true
            end
            
            if isDrop and not droppedItems[part] then
                local esp = newDrawing("Text")
                if esp then
                    esp.Size = 14
                    esp.Color = colors[colorIndex].Color
                    esp.Center = true
                    esp.Outline = true
                    esp.OutlineColor = Color3.new(0, 0, 0)
                    esp.Text = "📦 " .. part.Name
                    droppedItems[part] = esp
                end
            end
        end
    end
    
    for part, esp in pairs(droppedItems) do
        if not part or not part.Parent then
            if esp and esp.Remove then esp:Remove() end
            droppedItems[part] = nil
        else
            local vector, onScreen = Camera:WorldToScreenPoint(part.Position)
            if onScreen then
                esp.Visible = true
                esp.Position = Vector2.new(vector.X, vector.Y - 20)
                esp.Color = colors[colorIndex].Color
            else
                esp.Visible = false
            end
        end
    end
end

-- ===== RECARGAR MANUAL =====
RefreshBtn.MouseButton1Click:Connect(function()
    -- Limpiar todo y recrear
    for player in pairs(espObjects) do
        removePlayerESP(player)
    end
    for _, esp in pairs(droppedItems) do
        if esp and esp.Remove then esp:Remove() end
    end
    droppedItems = {}
    
    -- Recrear ESP para todos los jugadores
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            createPlayerESP(player)
        end
    end
    print("🔄 ESP recargado manualmente")
end)

-- ===== INICIALIZACIÓN =====
for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(function() createPlayerESP(player) end)
        createPlayerESP(player)
    end
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function() createPlayerESP(p) end)
end)

Players.PlayerRemoving:Connect(removePlayerESP)

-- Loop principal
RunService.RenderStepped:Connect(function()
    for player in pairs(espObjects) do
        updatePlayerESP(player)
    end
    updateDroppedItems()
end)

