-- Estados de los toggles
local function updateToggle(btn)
    btn.State = not btn.State
    btn.Text = btn.Text:gsub(" ✅", "") .. (btn.State and " ✅" or " ❌")
end

boxToggle.MouseButton1Click:Connect(function() updateToggle(boxToggle) end)
