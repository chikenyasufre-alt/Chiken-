-- Funciones de los botones
local function updateToggle(btn)
    btn.State = not btn.State
    btn.Text = btn.Text:gsub(" ✅", ""):gsub(" ❌", "") .. (btn.State and " ✅" or " ❌")
end

boxToggle.MouseButton1Click:Connect(function() updateToggle(boxToggle) end)
nameToggle.MouseButton1Click:Connect(function() updateToggle(nameToggle) end)
healthToggle.MouseButton1Click:Connect(function() updateToggle(healthToggle) end)
dropToggle.MouseButton1Click:Connect(function() updateToggle(dropToggle) end)

