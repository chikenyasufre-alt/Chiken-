-- Función para crear botones táctiles (más grandes)
local function createButton(parent, text, yPos, default)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.85, 0, 0, 45) -- Más alto para dedos
    btn.Position = UDim2.new(0.075, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = text .. (default and " ✅" or " ❌")
    btn.Font = Enum.Font.Gotham
    btn.TextScaled = true
    btn.Parent = parent
    btn.State = default
    return btn
end

